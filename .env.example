APP_URL=https://backstagetest.meedoo.fun
LARK_BRAND=lark
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=your_app_secret
LARK_SCOPES=auth:user.id:read
LARK_AUTH_REQUIRED=false
SESSION_SECRET=replace_with_at_least_32_random_characters
UPLOAD_POST_API_KEY=your_upload_post_api_key
UPLOAD_POST_PROFILE=meedoo_team
UPLOAD_POST_HISTORY_AFTER=
UPLOAD_POST_WEBHOOK_SECRET=your_upload_post_webhook_secret
DATABASE_URL=postgresql://meedoo:strong_password@127.0.0.1:5432/meedoo
MEEDOO_MEDIA_DIR=/var/lib/meedoo/media
MEDIA_URL_SECRET=replace_with_a_random_32_character_secret
CRON_SECRET=replace_with_a_random_32_character_secret
LARK_NOTIFY_ENABLED=false
# Application-specific open_id of the approver receiving publish-failure copies.
LARK_PUBLISH_FAILURE_ADMIN_OPEN_ID=
LARK_BASE_APP_TOKEN=
UPLOAD_POST_FACEBOOK_PAGE_ID=
MINIMAX_API_KEY=

# Volcengine Ark (China), server only; Seedance 2.0 / 2.5
ARK_API_KEY=

# Shopify Admin API (server only). Use the verified permanent *.myshopify.com domain.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional existing offline Admin token instead of client credentials:
SHOPIFY_ADMIN_ACCESS_TOKEN=
