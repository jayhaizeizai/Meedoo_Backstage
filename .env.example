APP_URL=https://backstagetest.meedoo.fun
LARK_BRAND=lark
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=your_app_secret
LARK_SCOPES=auth:user.id:read
LARK_AUTH_REQUIRED=false
SESSION_SECRET=replace_with_at_least_32_random_characters
UPLOAD_POST_API_KEY=your_upload_post_api_key
UPLOAD_POST_PROFILE=meedoo_team
UPLOAD_POST_HISTORY_AFTER=
UPLOAD_POST_WEBHOOK_SECRET=your_upload_post_webhook_secret
DATABASE_URL=postgresql://meedoo:strong_password@127.0.0.1:5432/meedoo
MEEDOO_MEDIA_DIR=/var/lib/meedoo/media
CRON_SECRET=replace_with_a_random_32_character_secret
LARK_NOTIFY_ENABLED=false
