{
  "name": "meedoo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm typecheck",
    "history:dry-run": "node scripts/import-organic-history.mjs --dry-run",
    "history:apply": "node scripts/import-organic-history.mjs --apply-db",
    "followers:dry-run": "node scripts/recalculate-follower-attributions.mjs --dry-run",
    "followers:apply": "node scripts/recalculate-follower-attributions.mjs --apply-db",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "accounting:mappings:export": "node scripts/export-libtv-member-mappings.cjs",
    "test": "node scripts/verify-accounting-config.cjs && node scripts/verify-platform-settings.cjs && node scripts/verify-upload-transport.cjs && node scripts/verify-tiktok-retention.cjs && node scripts/verify-facebook-x.cjs && node scripts/verify-generation.cjs",
    "test:integration": "node scripts/verify-reliability.cjs && node scripts/verify-tiktok-retention.cjs --db && node scripts/verify-facebook-x.cjs --db"
  },
  "dependencies": {
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
