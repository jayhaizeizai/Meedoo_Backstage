[Unit]
Description=MeeDoo publishing and analytics application
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/meedoo
Environment=NODE_ENV=production
EnvironmentFile=-/etc/meedoo/meedoo.env
ExecStart=/usr/local/bin/pnpm start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
