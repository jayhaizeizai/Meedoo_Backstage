[Unit]
Description=Synchronize MeeDoo Upload-Post history and analytics
After=meedoo.service

[Service]
Type=oneshot
EnvironmentFile=/etc/meedoo/meedoo.env
ExecStart=/usr/bin/curl --fail --silent --show-error --request POST --header "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3000/api/upload-post/sync
